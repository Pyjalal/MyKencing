{
  "name": "hono-medicine-api",
  "version": "1.0.0",
  "description": "Hono API for Malaysian medicine search and drug interaction checking",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "deploy": "wrangler deploy",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:generate": "npx supabase gen types typescript --local > src/types/database.ts",
    "db:reset": "npx supabase db reset",
    "db:migrate": "npx supabase db push",
    "populate:medicines": "tsx scripts/populate-medicines.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.2.1",
    "@supabase/supabase-js": "^2.39.0",
    "@types/node-cache": "^4.1.3",
    "cheerio": "^1.0.0-rc.12",
    "csv-parse": "^5.5.6",
    "dotenv": "^17.2.3",
    "hono": "^4.0.0",
    "node-cache": "^5.1.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.0",
    "jest": "^30.2.0",
    "supabase": "^2.53.6",
    "ts-jest": "^29.4.5",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "wrangler": "^3.22.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
